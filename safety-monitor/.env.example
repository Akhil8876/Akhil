# Copy to .env and fill in. Never commit the real .env.

PORT=3000
DB_PATH=data/safety.db
# Set to true when running behind a reverse proxy / load balancer that terminates HTTPS.
TRUST_PROXY=false

# Dashboard sign-in for the safety department.
DASHBOARD_PASSWORD=change-me
# Long random string; keeps operators signed in across restarts. e.g. `openssl rand -hex 32`
SESSION_SECRET=
SESSION_HOURS=12

# --- WhatsApp Business Cloud API (Meta) ---
# Any string you choose; enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App Dashboard > App settings > Basic > App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Permanent system-user token with whatsapp_business_messaging. Optional: enables auto-replies.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Public https address of this server, without a trailing slash, e.g. https://safety.example.org
# Used in live-sharing links and tracker setup, and for Twilio signature checks.
PUBLIC_BASE_URL=

# --- Twilio: WhatsApp and/or SMS (alternative to Meta) ---
TWILIO_AUTH_TOKEN=

# --- Any other SMS gateway (MSG91, Exotel, Gupshup, a GSM modem...) ---
# Long random string; the gateway posts to /webhook/sms?key=<this>.
SMS_WEBHOOK_KEY=
# Added to 10-digit national numbers (9876543210 -> +919876543210).
DEFAULT_COUNTRY_CODE=91

# --- Telegram bot (forwards *live* location, unlike WhatsApp) ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Long random string, passed as secret_token when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=

# --- Behaviour ---
EMERGENCY_NUMBER=112
# How long a TRACK link keeps working.
TRACK_LINK_HOURS=12
SOS_KEYWORDS=sos,help,emergency,danger,unsafe,bachao
# Minutes after which a person's last location is no longer shown as "active".
STALE_MINUTES=15
# Locations and messages older than this are deleted.
RETENTION_DAYS=30
MAX_SNAPSHOT_POINTS=20000

# Map tiles. The default is OpenStreetMap's public server, which is fine for light use only;
# use your own tile server or a commercial provider for a real control room.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
