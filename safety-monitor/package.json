{
  "name": "safety-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Women safety monitoring: people share their location to a WhatsApp safety number and the safety desk sees it live on a map.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "leaflet": "1.9"
  }
}
